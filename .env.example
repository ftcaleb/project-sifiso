# Optional: a Spline scene export URL (https://prod.spline.design/<id>/scene.splinecode).
# When set, the homepage hero mounts the Spline scene; when empty, the procedural
# WebGL spatial grid (react-three-fiber) renders instead. Both are cursor-reactive.
NEXT_PUBLIC_SPLINE_SCENE=

# Contact form (Resend HTTP API — works on Cloudflare Workers).
# Until a domain is verified in Resend, MAIL_FROM must stay onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM="Sifiso Holdings <onboarding@resend.dev>"
MAIL_TO=hello@example.com
MAIL_REPLY_TO=hello@example.com
SITE_URL=https://example.com
